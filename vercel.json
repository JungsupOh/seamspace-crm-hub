{
  "framework": "vite",
  "buildCommand": "npm run build",
  "installCommand": "npm install",
  "rewrites": [
    { "source": "/((?!api/).*)", "destination": "/index.html" }
  ],
  "functions": {
    "api/print/*.py": {
      "maxDuration": 60,
      "includeFiles": "api/print/_lib/**"
    }
  }
}
